{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest"
    ],
    "paths": {
      "@family-health-vault/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@family-health-vault/shared/*": [
        "./packages/shared/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "server/drizzle",
    "node_modules"
  ]
}
